<Window x:Class="DrawBench.Modules.Batch.Views.CategoryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="440" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="13" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border Margin="14" Background="{StaticResource Card}" CornerRadius="12"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                              Opacity="0.16" Color="#0E1A38" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource CardHead}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Click="BtnCancel_Click"
                            Style="{StaticResource GhostButton}" Padding="6,2" MinHeight="22" FontSize="11.5" />
                    <Border DockPanel.Dock="Left" Width="3" Height="13" CornerRadius="2"
                            Background="{StaticResource AccentGrad}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="管理 LoRA 分类" VerticalAlignment="Center"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </DockPanel>
            </Border>

            <!-- 新增分类输入条 -->
            <Grid Grid.Row="1" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtNewCategory" Margin="0"
                             TextChanged="TxtNewCategory_TextChanged"
                             KeyDown="TxtNewCategory_KeyDown" />
                    <TextBlock x:Name="TxtNewCategoryHint" Text="输入新分类名（如：画风、角色、动作）…"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
                </Grid>
                <Button Grid.Column="1" Content="+ 添加" Click="BtnAdd_Click"
                        Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" />
            </Grid>

            <!-- 分类列表 -->
            <Border Grid.Row="2" Margin="14,0,14,8" Style="{StaticResource Inset}" Padding="4">
                <Grid>
                    <TextBlock x:Name="TxtEmpty" Text="暂无自定义分类，请在上方输入名称后点击「+ 添加」。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="16" />
                    <ListBox x:Name="LstCategories" SelectionChanged="LstCategories_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="4,3" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 选中项操作（重命名 / 上下移 / 删除） -->
            <Grid Grid.Row="3" Margin="14,0,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRename" Grid.Column="0" Margin="0" IsEnabled="False"
                         ToolTip="修改选中分类的名称" KeyDown="TxtRename_KeyDown" />
                <Button x:Name="BtnRename" Grid.Column="1" Content="重命名" Click="BtnRename_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0" />
                <Button x:Name="BtnUp" Grid.Column="2" Content="↑" Click="BtnUp_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="6,0,0,0" ToolTip="上移" />
                <Button x:Name="BtnDown" Grid.Column="3" Content="↓" Click="BtnDown_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" ToolTip="下移" />
                <Button x:Name="BtnDelete" Grid.Column="4" Content="删除" Click="BtnDelete_Click" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0" />
            </Grid>

            <!-- 底栏 -->
            <Border Grid.Row="4" Padding="14,10" Background="{StaticResource CardHead}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" FontSize="11.5"
                               Text="重命名会同步原 LoRA；删除将回退为未分类。" />
                    <Button DockPanel.Dock="Right" Content="取消" Click="BtnCancel_Click"
                            Style="{StaticResource SecondaryButton}" Padding="14,5" Margin="8,0,0,0" IsCancel="True" />
                    <Button DockPanel.Dock="Right" Content="确定" Click="BtnOk_Click"
                            Style="{StaticResource PrimaryButton}" Padding="18,5" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
