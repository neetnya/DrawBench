<UserControl x:Class="DrawBench.Modules.Batch.Views.BatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13" FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        布局与「抽卡」页同一套：
        Row0 = 内容区（左右两栏，卡片各自撑满，两侧底边天然对齐）
        Row1 = 底栏，主操作按钮放在这里，不再挤在侧栏里
    -->
    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：工作流列表 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="ComfyUI" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="服务地址" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtBaseUrl" Text="http://127.0.0.1:8188"
                                 ToolTip="ComfyUI 服务地址，整个软件只有这里能改"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="工作流列表" Padding="0" Margin="0">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="10,8"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSelectAll" Content="全选" Click="BtnSelectAll_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,0" />
                                <Button x:Name="BtnSelectNone" Content="全不选" Click="BtnSelectNone_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,0" />
                                <Button x:Name="BtnReloadWorkflows" Content="刷新" Click="BtnReloadWorkflows_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" />
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Padding="10,8"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnOpenWorkflowFolder" DockPanel.Dock="Right" Content="打开目录"
                                        Click="BtnOpenWorkflowFolder_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,3" MinHeight="26"
                                        FontSize="12" Margin="8,0,0,0"
                                        ToolTip="在资源管理器中打开 api 工作流目录" />
                                <TextBlock Text="拖入 .json 可添加" VerticalAlignment="Center"
                                           Style="{StaticResource SubText}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AllowDrop="True" Padding="6,4"
                                      PreviewDragOver="WorkflowList_DragOver"
                                      PreviewDrop="WorkflowList_Drop">
                            <ItemsControl x:Name="LstWorkflows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip="{Binding Path}"
                                                  Padding="6,5" Margin="0,0,0,1" MinHeight="26"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox"
                                                       BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 + 选项 + 日志 ============ -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="正向提示词队列" Padding="0" Margin="0">
                    <TextBox x:Name="TxtPromptQueue"
                             Style="{StaticResource ConsoleBox}"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontSize="13" Text="" AllowDrop="True"
                             PreviewDragOver="Prompt_PreviewDragOver"
                             PreviewDrop="Prompt_PreviewDrop"
                             ToolTip="每行一组提示词，会依次写入标题含 Positive 的正向提示词节点。"/>
                </GroupBox>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="负面提示词" Padding="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBox x:Name="TxtNegativePrompt"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                     Height="96" Padding="5,4" Text="" AllowDrop="True"
                                     PreviewDragOver="Prompt_PreviewDragOver"
                                     PreviewDrop="Prompt_PreviewDrop"
                                     ToolTip="留空则不修改工作流里的负面提示词。填写后按与正向词相同的规则写入标题含 Negative 的节点（支持「Negative Prompt」占位符，否则追加到模板原文后面）；整个框算一条负面词，不按行分组，本批所有图共用。"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="生成选项" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="每组生成数量"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="TxtCount" Grid.Row="0" Grid.Column="1" Text="1"
                                     Margin="0,2,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="日期后缀"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="TxtDate" Grid.Row="1" Grid.Column="1" Text=""
                                     Margin="0,2,0,6"
                                     ToolTip="追加到保存文件名前缀后的日期。软件启动时自动填入当天日期（yyMMdd），可手动修改；点击「开始批量排队」不会重置它。"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="种子"
                                       Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="TxtSeed" Grid.Row="2" Grid.Column="1" Text="-1"
                                     Margin="0,2,0,8"
                                     TextChanged="TxtSeed_TextChanged"
                                     ToolTip="-1 表示保持原来的随机逻辑（按下面的锁定 seed 选项随机）；填其它整数则本批所有图都固定使用该 seed，此时「锁定 seed / 全局锁定 seed」不生效。"/>

                            <CheckBox x:Name="ChkLockSeed" Grid.Row="3" Grid.ColumnSpan="2"
                                      Margin="0,2,0,0" VerticalAlignment="Center"
                                      Content="🔒 锁定 seed"
                                      ToolTip="勾选后：同一条提示词提交到所有工作流时使用同一个 seed，方便对比不同工作流；不同提示词之间仍然各自随机。填了固定种子时以固定种子为准。"/>

                            <CheckBox x:Name="ChkGlobalLockSeed" Grid.Row="4" Grid.ColumnSpan="2"
                                      Margin="0,4,0,0" VerticalAlignment="Center"
                                      Content="🌐 全局锁定 seed"
                                      Checked="ChkGlobalLockSeed_Changed" Unchecked="ChkGlobalLockSeed_Changed"
                                      ToolTip="勾选后：按轮生成 seed，每一轮开始随机一个 seed，本轮内所有提示词、所有工作流共用该 seed，画完这一轮再换下一个 seed 重复。每组生成数量为 N 时共 N 轮，同一轮内的图相同；与「锁定 seed」同时勾选时以本项为准。填了固定种子时以固定种子为准。"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="运行日志" Padding="0" Margin="0">
                        <TextBox x:Name="TxtLog" IsReadOnly="True"
                                 Style="{StaticResource ConsoleBox}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 TextWrapping="Wrap" IsTabStop="False" Text=""
                                 Foreground="{StaticResource InkSoft}" Background="{StaticResource InputBg}" />
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="1" Margin="12,12,12,12" Padding="12" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnRun" Grid.Column="0" Content="开始批量排队" Click="BtnRun_Click"
                        Style="{StaticResource PrimaryButton}" Padding="24,7" MinWidth="140" />
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="就绪" VerticalAlignment="Center"
                           Margin="16,0,4,0" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
