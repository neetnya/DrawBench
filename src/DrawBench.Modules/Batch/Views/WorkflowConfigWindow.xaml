<Window x:Class="DrawBench.Modules.Batch.Views.WorkflowConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DrawBench.Modules.Batch.Controls"
        Title="工作流 API 与全局 LoRA 配置"
        Width="1020" Height="730" MinWidth="840" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        FontSize="13" FontFamily="{StaticResource AppFont}"
        Background="{StaticResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：ComfyUI 模型同步条 ============ -->
        <Border Grid.Row="0" Padding="12,8" Margin="0,0,0,10" Style="{StaticResource PanelCard}">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnRefreshCatalog" DockPanel.Dock="Right" Content="刷新 ComfyUI 模型列表"
                        Click="BtnRefreshCatalog_Click"
                        Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="10,0,0,0" />
                <TextBlock x:Name="TxtCatalogStatus" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           Text="正在从 ComfyUI 获取模型与 LoRA 列表…"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============ 中部：双页签（工作流 API / 全局 LoRA 管理） ============ -->
        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ==================== 页签 1：工作流 API ==================== -->
            <TabItem Header="工作流 API">
                <!-- 重置 FontWeight="Normal"，避免继承 Theme.xaml 中 TabItem 选中态的 SemiBold -->
                <Grid Margin="10" TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="210" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="500" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：工作流 API 列表 -->
                    <GroupBox Grid.Column="0" Header="工作流 API 列表" Padding="0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Padding="8,8"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                <WrapPanel>
                                    <Button Content="+ 新建" Click="BtnAddWorkflow_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,5,4" />
                                    <Button Content="复制" Click="BtnDuplicateWorkflow_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,5,4" />
                                    <Button Content="删除" Click="BtnDeleteWorkflow_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,5,4" />
                                    <Button Content="↑" Click="BtnMoveUp_Click" ToolTip="上移"
                                            Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,4,4" />
                                    <Button Content="↓" Click="BtnMoveDown_Click" ToolTip="下移"
                                            Style="{StaticResource SecondaryButton}" Padding="7,3" Margin="0,0,0,4" />
                                </WrapPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Padding="8,8"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                                <Button Content="从旧版 .json 导入…" Click="BtnImportJson_Click"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="可选：将旧版 ComfyUI API .json 转换为可视化配置项" />
                            </Border>

                            <ListBox x:Name="LstConfigs"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="4"
                                     SelectionChanged="LstConfigs_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Padding="4,4" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

                    <!-- 右：可视化参数表单 -->
                    <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="0">
                        <Grid>
                            <TextBlock x:Name="TxtEmptyHint"
                                       Text="点击左侧「+ 新建」添加工作流 API，或点击「从旧版 .json 导入…」迁移现有工作流。"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="24" />

                            <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="12,10" Visibility="Collapsed">
                                <StackPanel x:Name="PnlEditor">
                                    <!-- 1. 基本信息 -->
                                    <GroupBox Header="基本信息" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" MinWidth="78" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="工作流名称" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,6"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="保存前缀" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Row="0" Grid.Column="4" Margin="0,2,0,6"
                                                     Text="{Binding FilenamePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="对应 SaveImage 的 filename_prefix，例如 boleromixLora/" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="底模架构" Style="{StaticResource FormLabel}" />
                                            <ComboBox x:Name="CmbLoaderMode" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                      Margin="0,2,0,0" SelectionChanged="CmbLoaderMode_SelectionChanged">
                                                <ComboBoxItem Content="Checkpoint 整合模型（SDXL / Illustrious）" Tag="Checkpoint" />
                                                <ComboBoxItem Content="UNet + CLIP + VAE 分离加载（Anima / Flux）" Tag="UnetSplit" />
                                            </ComboBox>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 2. 底模配置 -->
                                    <GroupBox Header="底模模型" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Checkpoint 模式 -->
                                            <Grid x:Name="PnlCheckpoint">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="78" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Checkpoint" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbCheckpoint" Grid.Column="1"
                                                          ItemsSource="{Binding CheckpointOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding CheckpointName, Mode=TwoWay}" />
                                            </Grid>

                                            <!-- UNet 分离模式 -->
                                            <Grid x:Name="PnlUnetSplit" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="78" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" MinWidth="74" />
                                                    <ColumnDefinition Width="160" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="UNet 模型" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbUnet" Grid.Row="0" Grid.Column="1" Margin="0,2,0,6"
                                                          ItemsSource="{Binding UnetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding UnetName, Mode=TwoWay}" />
                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="精度" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbWeightDtype" Grid.Row="0" Grid.Column="4" Margin="0,2,0,6"
                                                          ItemsSource="{Binding WeightDtypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding WeightDtype, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="CLIP 模型" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbClip" Grid.Row="1" Grid.Column="1" Margin="0,2,0,6"
                                                          ItemsSource="{Binding ClipOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding ClipName, Mode=TwoWay}" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="CLIP 类型" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbClipType" Grid.Row="1" Grid.Column="4" Margin="0,2,0,6"
                                                          ItemsSource="{Binding ClipTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding ClipType, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="VAE 模型" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbVae" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,2,0,0"
                                                          ItemsSource="{Binding VaeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding VaeName, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 3. LoRA 列表 -->
                                    <GroupBox Padding="12,10" Margin="0,0,0,10">
                                        <GroupBox.Header>
                                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Text="LoRA 配置" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="+ 添加 LoRA"
                                                        Click="BtnAddLora_Click"
                                                        Style="{StaticResource SmallButton}" Margin="10,0,0,0" />
                                                <CheckBox x:Name="ChkAutoFilterLora" DockPanel.Dock="Right"
                                                          IsChecked="True" VerticalAlignment="Center"
                                                          FontWeight="Normal" FontSize="11.5" Margin="0,0,4,0"
                                                          Content="按架构过滤"
                                                          Checked="ChkAutoFilterLora_Changed"
                                                          Unchecked="ChkAutoFilterLora_Changed"
                                                          ToolTip="勾选后：Checkpoint 模式自动筛选 illustrious 目录，UNet 模式自动筛选 anima 目录；取消勾选显示全部 LoRA" />
                                            </DockPanel>
                                        </GroupBox.Header>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtNoLoraHint" Text="未挂载 LoRA，点击右上角「+ 添加 LoRA」添加。"
                                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2" />

                                            <ItemsControl x:Name="LstLoras">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                                                                CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                                                Background="{StaticResource InputBg}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="56" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="56" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                          VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="勾选启用此 LoRA" />
                                                                <controls:LoraPicker Grid.Row="0" Grid.Column="1"
                                                                                     ItemsSource="{Binding FilteredLoraOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     AliasMap="{Binding LoraAliasMap, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     SelectedLora="{Binding LoraName, Mode=TwoWay}"
                                                                                     Margin="0,2,8,2"
                                                                                     ToolTip="点击展开并输入路径或别名搜索 LoRA" />

                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="模型" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,4,0" />
                                                                <TextBox Grid.Row="0" Grid.Column="3"
                                                                         Text="{Binding StrengthModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                         Margin="0,2,8,2" ToolTip="strength_model" />

                                                                <TextBlock Grid.Row="0" Grid.Column="4" Text="CLIP" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,4,0" />
                                                                <TextBox Grid.Row="0" Grid.Column="5"
                                                                         Text="{Binding StrengthClip, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                         IsEnabled="{Binding IsCurrentCheckpointMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Margin="0,2,8,2" ToolTip="strength_clip（UNet 分离模式自动忽略）" />

                                                                <Button Grid.Row="0" Grid.Column="6" Content="移除"
                                                                        Click="BtnRemoveLora_Click" Tag="{Binding}"
                                                                        Style="{StaticResource SmallButton}" Margin="0"
                                                                        ToolTip="仅从当前工作流移除挂载，不会删除全局 LoRA 库里的触发词与别名" />

                                                                <!-- 触发词行（实时联动全局 LoRA 库） -->
                                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="LoRA触发词" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="20,6,6,0" />
                                                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Margin="0,6,0,0"
                                                                         IsEnabled="{Binding HasLoraSelected}"
                                                                         Text="{Binding TriggerWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="此触发词同步保存在「全局 LoRA 管理」中，所有使用该 LoRA 的工作流共享" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 4. 采样与尺寸（所有采样器与调度器参数均在卡片内） -->
                                    <GroupBox Header="采样与画幅" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" MinWidth="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" MinWidth="54" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="宽" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,6"
                                                         Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="高" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="0" Grid.Column="4" Margin="0,2,0,6"
                                                         Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="0" Grid.Column="6" Text="去噪" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="0" Grid.Column="7" Margin="0,2,0,6"
                                                         Text="{Binding Denoise, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="步数" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,6"
                                                         Text="{Binding Steps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="CFG" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,2,0,6"
                                                         Text="{Binding Cfg, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="1" Grid.Column="6" Text="批次" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="7" Margin="0,2,0,6"
                                                         Text="{Binding BatchSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="对应 EmptyLatentImage 的 batch_size，一般保持 1" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" MinWidth="54" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="采样器" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbSampler" Grid.Column="1"
                                                          ItemsSource="{Binding SamplerOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SamplerName, Mode=TwoWay}" />

                                                <TextBlock Grid.Column="3" Text="调度器" Style="{StaticResource FormLabel}" />
                                                <ComboBox x:Name="CmbScheduler" Grid.Column="4"
                                                          ItemsSource="{Binding SchedulerOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Scheduler, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 5. 提示词模板 -->
                                    <GroupBox Header="默认提示词模板" Padding="12,10" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="默认正向词（支持 Positive Prompt 占位符，留空则直接用主界面队列词）"
                                                       Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                                     VerticalScrollBarVisibility="Auto" Padding="5,4" Margin="0,0,0,8"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Text="{Binding PositiveTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="默认负面词（主界面负面词留空时使用此项；支持 Negative Prompt 占位符）"
                                                       Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                                     VerticalScrollBarVisibility="Auto" Padding="5,4"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Text="{Binding NegativeTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== 页签 2：全局 LoRA 管理 ==================== -->
            <TabItem Header="全局 LoRA 管理">
                <!-- 重置 FontWeight="Normal"，避免继承 TabItem 选中态的 SemiBold -->
                <Grid Margin="10" TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" MinWidth="250" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="460" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：全局 LoRA 列表 -->
                    <GroupBox Grid.Column="0" Padding="0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="全局 LoRA 库" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentSoft}"
                                        CornerRadius="9" Padding="7,1.5" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGlobalLoraCount" FontSize="11"
                                               Foreground="{StaticResource AccentDeep}" FontWeight="SemiBold" Text="0 个" />
                                </Border>
                            </StackPanel>
                        </GroupBox.Header>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <Border Padding="8,8" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="+ 添加 LoRA" Click="BtnAddGlobalLora_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="0,0,6,0" />
                                        <Button Content="删除" Click="BtnDeleteGlobalLora_Click"
                                                Style="{StaticResource SecondaryButton}" Padding="10,3"
                                                ToolTip="从全局 LoRA 库彻底删除选中项" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="8,6" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBox x:Name="TxtGlobalLoraSearch" Margin="0"
                                                 TextChanged="TxtGlobalLoraSearch_TextChanged" />
                                        <TextBlock x:Name="TxtGlobalLoraSearchHint"
                                                   Text="搜索路径、别名或触发词…"
                                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <ListBox x:Name="LstGlobalLoras"
                                     BorderThickness="0" Background="Transparent" Padding="4"
                                     SelectionChanged="LstGlobalLoras_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LoraName}" FontSize="11"
                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11"
                                                       Foreground="{StaticResource AccentDeep}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

                    <!-- 右：全局 LoRA 详情、改名迁移与引用查看 -->
                    <Border Grid.Column="2" Style="{StaticResource Inset}" Padding="0">
                        <Grid>
                            <TextBlock x:Name="TxtGlobalLoraEmptyHint"
                                       Text="在左侧选择一个 LoRA 进行管理，或点「+ 添加 LoRA」预先录入触发词与别名。"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="24" />

                            <ScrollViewer x:Name="GlobalLoraScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="12,10" Visibility="Collapsed">
                                <StackPanel x:Name="PnlGlobalLoraEditor">

                                    <!-- 1. 文件路径与改名迁移 -->
                                    <GroupBox Header="LoRA 文件路径与改名迁移" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="当前路径（ComfyUI 相对路径）" Style="{StaticResource FieldLabel}"
                                                       HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <TextBox IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                                     Background="{StaticResource CardHead}"
                                                     Text="{Binding LoraName, Mode=OneWay}" Margin="0,0,0,10" />

                                            <TextBlock Text="文件在硬盘改名或移动目录后，可在下方选择新文件并一键同步所有工作流："
                                                       Style="{StaticResource SubText}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:LoraPicker x:Name="PickerRenameTarget" Grid.Column="0"
                                                                     ItemsSource="{Binding AllComfyLoraOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Margin="0,2,8,2" />
                                                <Button Grid.Column="1" Content="改名并同步工作流"
                                                        Click="BtnRenameGlobalLora_Click"
                                                        Style="{StaticResource SecondaryButton}" Padding="12,4" />
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 2. 别名、默认权重与触发词 -->
                                    <GroupBox Header="别名、默认权重与全局触发词" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="显示别名" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="起一个好记的中文/短名，在工作流下拉选 LoRA 时可直接搜索此别名" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="默认模型权重" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding DefaultStrengthModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Grid.Column="3" Text="默认CLIP权重" Style="{StaticResource FormLabel}" />
                                                <TextBox Grid.Column="4"
                                                         Text="{Binding DefaultStrengthClip, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </Grid>

                                            <TextBlock Text="全局触发词（所有挂载此 LoRA 的工作流提交时自动拼入正向词）"
                                                       Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" Margin="0,0,0,4" />
                                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="82"
                                                     VerticalScrollBarVisibility="Auto" Padding="5,4"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Text="{Binding TriggerWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </GroupBox>

                                    <!-- 3. 引用情况 -->
                                    <GroupBox Header="工作流引用情况" Padding="12,10" Margin="0">
                                        <TextBlock x:Name="TxtGlobalLoraUsage" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkSoft}" LineHeight="20" />
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ============ 底栏：保存 / 取消 ============ -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" Style="{StaticResource PanelCard}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           Text="提示：工作流里移除 LoRA 仅解除挂载，不会删除「全局 LoRA 管理」中的触发词与别名；文件改名后可在全局管理页一键迁移。" />
                <Button DockPanel.Dock="Right" Content="取消" Click="BtnCancel_Click"
                        Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="保存并关闭" Click="BtnSave_Click"
                        Style="{StaticResource PrimaryButton}" Padding="20,6" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
