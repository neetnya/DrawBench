<UserControl x:Class="DrawBench.Modules.Batch.Controls.LoraPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="27" MinHeight="27" VerticalAlignment="Center" Margin="0,2">
    <Grid>
        <!-- 外观与 Theme.xaml 中的 ComboBox 完全保持一致 -->
        <ToggleButton x:Name="BtnToggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                      Checked="BtnToggle_Checked" Unchecked="BtnToggle_Unchecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0" Data="M0,0 L7,0 L3.5,4.5 Z" Fill="#9AA4B8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#C3CDE4" />
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Chrome" Property="Background" Value="White" />
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <TextBlock x:Name="TxtDisplay" IsHitTestVisible="False"
                   Margin="10,0,26,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource AppFont}" FontSize="12.5"
                   Foreground="{StaticResource Ink}"
                   TextTrimming="CharacterEllipsis" />

        <Popup x:Name="PopupDropDown" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnToggle}"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
               Opened="PopupDropDown_Opened" Closed="PopupDropDown_Closed">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Margin="0,4,0,0" Padding="6"
                    MinWidth="{Binding ActualWidth, ElementName=BtnToggle}"
                    MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Opacity="0.14" Color="#1B2440" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 搜索输入框 -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBox x:Name="TxtFilter" Margin="0"
                                 TextChanged="TxtFilter_TextChanged"
                                 PreviewKeyDown="TxtFilter_PreviewKeyDown" />
                        <TextBlock x:Name="TxtFilterPlaceholder"
                                   Text="输入关键字过滤 LoRA（空格分隔多词）…"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" />
                    </Grid>

                    <!-- 过滤结果统计 -->
                    <TextBlock x:Name="TxtCountHint" Grid.Row="1" Margin="2,0,2,4"
                               FontSize="11" Foreground="{StaticResource Muted}" />

                    <!-- 候选项列表 -->
                    <ListBox x:Name="LstFiltered" Grid.Row="2" MaxHeight="240"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="LstFiltered_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="LstFiltered_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
