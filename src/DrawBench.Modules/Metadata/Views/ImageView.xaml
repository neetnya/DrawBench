<UserControl x:Class="DrawBench.Modules.Metadata.Views.ImageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="{StaticResource BgBrush}"
        FontSize="13" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DrawBench.Modules;component/Metadata/Resources/Metadata.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Border Grid.Row="0" Margin="6,6,6,0" Padding="6,5" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="文件夹" Style="{StaticResource FieldLabel}"
                           Margin="0,0,5,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="也可以把文件夹直接拖进窗口里" />

                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                        Margin="4,0,0,0" Click="BrowseFolder_Click" />
                <Button Grid.Column="3" Content="读取全部" Style="{StaticResource PrimaryButton}"
                        Margin="4,0,0,0" Click="Scan_Click" />
                <CheckBox Grid.Column="4" Content="包含子文件夹" Margin="7,0,0,0"
                          IsChecked="{Binding IncludeSubFolders}" />
            </Grid>
        </Border>

        <!-- 主体：文件列表 | 预览与信息 | 参数详情 -->
        <Grid Grid.Row="1" Margin="6,5,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <GroupBox Grid.Column="0" Header="图片列表" Padding="0" Margin="0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Bottom" Padding="6,3.5"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding Images.Count, StringFormat='共 {0} 张'}"
                                   Style="{StaticResource SubText}" FontSize="11.5" />
                    </Border>

                    <ListBox x:Name="FileList"
                             ItemsSource="{Binding ImagesView}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             Margin="3,3,3,2"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="2.5,2" />
                                <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="66">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource ImageBackBrush}" CornerRadius="6" Margin="0,0,4.5,0"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                                   Foreground="{StaticResource InkSoft}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding PromptPreview}" FontSize="11"
                                                   Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

            <!-- 预览 + 基本信息 | 参数详情 -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="240" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="预览" Padding="6,5" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Inset}"
                                Background="{StaticResource ImageBackBrush}" Padding="2">
                            <Grid>
                                <Image Source="{Binding Selected.Preview}" Stretch="Uniform" Margin="1"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="左边点一张图看看" Foreground="{StaticResource Muted}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"
                                      MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.FileName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="生成工具" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.SourceText}"
                                               Style="{StaticResource InfoValue}" Foreground="{StaticResource Accent}" />

                                    <TextBlock Grid.Row="1" Text="模型" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ModelText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="2" Text="尺寸" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.ResolutionText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="3" Text="大小" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.FileSizeText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="4" Text="修改时间" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding Selected.ModifiedTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                               Style="{StaticResource InfoValue}" />
                                </Grid>

                                <TextBlock Text="{Binding Selected.Error}" Foreground="{StaticResource Danger}"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

                <!-- 参数详情：三块各占一段高度、各自滚动，外层没有整体滚动条 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="0.85*" MinHeight="90" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="1.5*" MinHeight="150" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="正向提示词" Padding="0" Margin="0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Padding="5,3"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="复制" Style="{StaticResource SmallButton}" Click="CopyPositive_Click" />
                                    <Button Content="发送到队列" Style="{StaticResource SmallButton}"
                                            Click="SendPositiveToBatch_Click"
                                            ToolTip="把这段提示词送进「批量提交」模块的队列" />
                                </StackPanel>
                            </Border>
                            <TextBox Text="{Binding Selected.PositivePrompt, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource ConsoleBox}" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="负向提示词" Padding="0" Margin="0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Padding="5,3"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="复制" Style="{StaticResource SmallButton}" Click="CopyNegative_Click" />
                                    <Button Content="发送到队列" Style="{StaticResource SmallButton}"
                                            Click="SendNegativeToBatch_Click"
                                            ToolTip="送进「批量提交」模块的负向提示词框" />
                                </StackPanel>
                            </Border>
                            <TextBox Text="{Binding Selected.NegativePromptText, Mode=OneWay}" IsReadOnly="True"
                                     Style="{StaticResource ConsoleBox}" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Header="生成参数" Padding="0" Margin="0">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Padding="5,3"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                                <Button Content="复制值" HorizontalAlignment="Right"
                                        Style="{StaticResource SmallButton}" Click="CopyParams_Click"
                                        ToolTip="复制选中行的参数值（不含项目名）" />
                            </Border>
                            <DataGrid x:Name="ParamsGrid" ItemsSource="{Binding Selected.Params.ParameterItems}"
                                      IsReadOnly="True" ClipboardCopyMode="None"
                                      PreviewKeyDown="ParamsGrid_PreviewKeyDown"
                                      VerticalScrollBarVisibility="Auto" Margin="0,0,0,2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="130" />
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Margin="6,5,6,6" Padding="6,4" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource InkSoft}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="140" Height="6" IsIndeterminate="True"
                             VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</UserControl>
