<UserControl x:Class="DrawBench.Modules.Metadata.Views.ImageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="#F6F7F9"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DrawBench.Modules;component/Metadata/Resources/Metadata.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- 顶部工具条 -->
        <Border DockPanel.Dock="Top" Background="White" Padding="14,12"
                BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="文件夹" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#4B5563" />

                <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="10,0"
                         Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="也可以把文件夹直接拖进窗口里" />

                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource ToolButton}" Click="BrowseFolder_Click" />
                <Button Grid.Column="3" Content="读取全部" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                <CheckBox Grid.Column="4" Content="包含子文件夹" VerticalAlignment="Center" Margin="14,0,0,0"
                          IsChecked="{Binding IncludeSubFolders}" />
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource SoftBorderBrush}"
                   BorderThickness="0,1,0,0" Padding="8,2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="#4B5563" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="140" Height="10" IsIndeterminate="True" Background="#EEF2F7"
                             Foreground="{StaticResource AccentBrush}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体 -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- 文件列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource SoftBorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="图片列表" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Images.Count, StringFormat='共 {0} 张'}"
                                       HorizontalAlignment="Right" Foreground="#9CA3AF" FontSize="12" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="FileList"
                             ItemsSource="{Binding ImagesView}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="4,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="74">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#1F2124" CornerRadius="4" Margin="0,2,10,2">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                                   Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding PromptPreview}" FontSize="11"
                                                   Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 详情区 -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="240" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 预览 + 基本信息 -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="330" Background="#1F2124" CornerRadius="4">
                            <Grid>
                                <Image Source="{Binding Selected.Preview}" Stretch="Uniform" Margin="4"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="← 左边点一张图看看嘛" Foreground="#9CA3AF" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.FileName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="生成工具" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.SourceText}"
                                               Style="{StaticResource InfoValue}" Foreground="{StaticResource AccentBrush}" />

                                    <TextBlock Grid.Row="1" Text="模型" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ModelText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="2" Text="尺寸" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.ResolutionText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="3" Text="大小" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.FileSizeText}"
                                               Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="4" Text="修改时间" Style="{StaticResource InfoKey}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding Selected.ModifiedTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                               Style="{StaticResource InfoValue}" />
                                </Grid>

                                <TextBlock Text="{Binding Selected.Error}" Foreground="#D14343"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 参数详情：三块各占一段高度、各自滚动，外层不再有整体滚动条 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*" />
                        <RowDefinition Height="0.9*" />
                        <RowDefinition Height="1.5*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="正向提示词" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="复制" Style="{StaticResource SmallButton}" Click="CopyPositive_Click" />
                                <Button Content="发送到队列" Style="{StaticResource SmallButton}" Click="SendPositiveToBatch_Click" ToolTip="把这段提示词送进「批量提交」模块的队列" />
                            </StackPanel>
                        </GroupBox.Header>
                        <TextBox Text="{Binding Selected.PositivePrompt, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" Padding="2" />
                    </GroupBox>

                    <GroupBox Grid.Row="1">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="负向提示词" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="复制" Style="{StaticResource SmallButton}" Click="CopyNegative_Click" />
                                <Button Content="发送到队列" Style="{StaticResource SmallButton}" Click="SendNegativeToBatch_Click" ToolTip="送进「批量提交」模块的负向提示词框" />
                            </StackPanel>
                        </GroupBox.Header>
                        <TextBox Text="{Binding Selected.NegativePromptText, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent" Padding="2" />
                    </GroupBox>

                    <GroupBox Grid.Row="2">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="生成参数" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Content="复制值" Style="{StaticResource SmallButton}" Click="CopyParams_Click"
                                        ToolTip="复制选中行的参数值（不含项目名）" />
                            </StackPanel>
                        </GroupBox.Header>
                        <DataGrid x:Name="ParamsGrid" ItemsSource="{Binding Selected.Params.ParameterItems}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" BorderThickness="0"
                                  Background="Transparent" FontSize="12"
                                  ClipboardCopyMode="None"
                                  PreviewKeyDown="ParamsGrid_PreviewKeyDown"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalGridLinesBrush="#EEF1F4" VerticalGridLinesBrush="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目" Binding="{Binding Key}" Width="130" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
