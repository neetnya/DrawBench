<UserControl x:Class="DrawBench.Modules.Tagger.Views.TaggerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DrawBench.Modules.Tagger.ViewModels"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Background="{StaticResource BgBrush}"
        FontSize="13" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 工具条：操作按钮 + 模型选择 ══ -->
        <Border Grid.Row="0" Margin="6,6,6,0" Padding="6,5" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择目录" Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="添加图片" Command="{Binding AddFilesCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" />
                    <Button Content="开始反推" Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="10,2.5" Margin="8,0,0,0" />
                    <Button Content="反推选中" Command="{Binding StartSelectedCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" />
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" MinWidth="72" />
                    <Button Content="停止" Command="{Binding StopCommand}"
                            Style="{StaticResource DangerButton}" Margin="4,0,0,0" />
                    <Button Content="清空队列" Command="{Binding ClearCommand}"
                            Style="{StaticResource GhostButton}" Margin="4,0,0,0" />
                    <Button Content="删除选中" Command="{Binding RemoveSelectedCommand}"
                            Style="{StaticResource GhostButton}" Margin="4,0,0,0" />
                    <Button Content="清空数据" Command="{Binding ClearDataCommand}"
                            Style="{StaticResource DangerButton}" Margin="4,0,0,0"
                            ToolTip="清空 data\results.csv 里保存的全部反推结果，队列里已完成的图片会恢复为待处理" />
                </WrapPanel>

                <ComboBox Grid.Column="1" Width="230" Margin="8,0,0,0"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                          ToolTip="{Binding ModelSummary}" />
            </Grid>
        </Border>

        <!-- ══ 三栏内容 ══ -->
        <Grid Grid.Row="1" Margin="6,5,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 队列 -->
            <GroupBox Grid.Column="0" Header="队列" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="6,3.5"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource SubText}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Margin="3,3,3,3"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                            Background="{StaticResource ImageBackBrush}" ClipToBounds="True">
                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="4.5,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TagsPreview}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="15" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding StateBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ElapsedText}" FontSize="10.5"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🐋" FontSize="30" HorizontalAlignment="Center" Opacity="0.45" />
                        <TextBlock Text="把图片文件夹拖到这里" Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

            <!-- 预览 + 标签 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*" MinHeight="150" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" MinHeight="130" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="预览" Padding="5" Margin="0">
                    <Border Style="{StaticResource Inset}" Background="{StaticResource ImageBackBrush}" Padding="2">
                        <Grid>
                            <Image Source="{Binding DetailImage}" Stretch="Uniform" />
                            <TextBlock Text="选中队列里的图片即可预览"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="标签" Padding="0" Margin="0">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="5,3"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}"
                                        CornerRadius="9" Padding="3.5,0.75" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedRating}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedRating}" FontSize="11"
                                               Foreground="{StaticResource AccentDeep}" FontWeight="SemiBold" />
                                </Border>
                                <Button DockPanel.Dock="Right" Content="发送到队列"
                                        Command="{Binding SendTagsToBatchCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="6,2"
                                        ToolTip="把这段标签送进「批量提交」模块的正向提示词队列" />
                                <Button DockPanel.Dock="Right" Content="复制标签"
                                        Command="{Binding CopyTagsCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="6,2" Margin="0,0,3,0" />
                            </DockPanel>
                        </Border>

                        <TextBox Text="{Binding SelectedTagsText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource ConsoleBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="13" />
                    </DockPanel>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource SplitLine}" ResizeBehavior="PreviousAndNext" />

            <!-- 参数 -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,0">
                <StackPanel>
                    <GroupBox Header="检测参数" Padding="7,6" Margin="0,0,0,5">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="普通标签阈值" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ThresholdText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentDeep}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0.05" Maximum="0.95"
                                    Value="{Binding Threshold}" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="角色标签阈值" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding CharacterThresholdText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentDeep}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="0.05" Maximum="0.99"
                                    Value="{Binding CharacterThreshold}" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" Margin="0,0,0,5" />

                            <CheckBox Content="附带分级标签（general / sensitive / …）"
                                      IsChecked="{Binding OutputRating}" Margin="0,2,0,5" />

                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="推理线程" Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ThreadsText}" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentDeep}" />
                            </Grid>
                            <Slider Style="{StaticResource FlatSlider}" Minimum="1" Maximum="32"
                                    Value="{Binding Threads}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Text="线程数越多不一定越快，8 左右通常最稳。"
                                       Style="{StaticResource SubText}" FontSize="11" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="复制格式" Padding="7,6" Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="只影响「复制标签」与「发送到队列」得到的文本，不影响存档结果。"
                                       Style="{StaticResource SubText}" FontSize="11" Margin="0,0,0,4"
                                       TextWrapping="Wrap" />
                            <CheckBox Content="下划线转空格" IsChecked="{Binding ReplaceUnderscore}" />
                            <CheckBox Content="末尾加逗号" IsChecked="{Binding TrailingComma}" />
                            <CheckBox Content="括号转义为 \( \)" IsChecked="{Binding EscapeParens}">
                                <CheckBox.ToolTip>
                                    <ToolTip Placement="Mouse" VerticalOffset="6">
                                        <TextBlock Text="复制成 a \(cosplay\) 的形式；不勾选则括号原样输出"
                                                   TextWrapping="Wrap" MaxWidth="300" />
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ 底部状态 ══ -->
        <Border Grid.Row="2" Margin="6,5,6,6" Padding="6,4" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                    <TextBlock Text="{Binding CurrentFile}" Style="{StaticResource SubText}" FontSize="12"
                               Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding ProgressText}"
                           Style="{StaticResource SubText}"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
