<UserControl x:Class="DrawBench.Modules.Gacha.Views.GachaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RollCommand}" />
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding RollCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：抽卡设置（基础设置 → 预设 → 核心下拉 → 维度勾选） ============ -->
            <GroupBox Grid.Column="0" Header="抽卡设置" Padding="10,8,10,8" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <!-- 1. 通用控制 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="连抽" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" x:Name="TxtRepeat"
                                     MaxLength="2"
                                     Text="{Binding RepeatText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="OnRepeatPreviewTextInput"
                                     DataObject.Pasting="OnRepeatPasting"
                                     LostFocus="OnRepeatLostFocus" />
                            <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                <CheckBox Content="下划线转空格"
                                          IsChecked="{Binding ReplaceUnderscoreWithSpace}"
                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <CheckBox Content="启用过激池"
                                          IsChecked="{Binding IncludeNsfw}"
                                          Margin="0,0,12,0" VerticalAlignment="Center"
                                          ToolTip="关闭时只抽常规池；开启时混合抽取常规池与过激（Explicit）池" />
                                <CheckBox Content="启用多人"
                                          IsChecked="{Binding AllowMultiPerson}"
                                          VerticalAlignment="Center"
                                          ToolTip="关闭时不抽需要多人的 tag；开启时若抽到多人 tag 则自动屏蔽前置 1girl, solo，未抽到则保留" />
                            </WrapPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="前置" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding PrefixTags, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="固定拼接在每条结果最前面，逗号分隔" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="后置" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                     Text="{Binding SuffixTags, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="固定拼接在每条结果最后面，逗号分隔" />
                        </Grid>

                        <!-- 自定义预设栏（选择 / 新建 / 改名保存 / 删除 / 取消全选） -->
                        <Border Background="{StaticResource InputSoftBrush}" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="6" Padding="8,7" Margin="0,8,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 行 1：下拉选择 + 新建 + 删除 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="预设" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CmbPresets" Grid.Row="0" Grid.Column="1" Height="26"
                                          ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          ToolTip="切换后立即加载该预设的所有抽卡参数" />
                                <Button Grid.Row="0" Grid.Column="2" Content="新建"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,3" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                        Click="OnPresetNew"
                                        ToolTip="按当前抽卡配置新建一条预设" />
                                <Button Grid.Row="0" Grid.Column="3" Content="删除"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasSelectedPreset}"
                                        Padding="10,3" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                        Click="OnPresetDelete"
                                        ToolTip="删除当前选中的预设" />

                                <!-- 行 2：名称输入 + 保存 + 取消全选 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtPresetName" Grid.Row="2" Grid.Column="1" Height="26" Margin="0"
                                         Text="{Binding PresetNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="修改当前预设名称，点击右侧「保存」连同所有选项一起保存" />
                                <Button Grid.Row="2" Grid.Column="2" Content="保存"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,3" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                        Click="OnPresetSave"
                                        ToolTip="保存当前名称和全部抽卡参数到当前预设" />
                                <Button Grid.Row="2" Grid.Column="3" Content="取消全选"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                        Click="OnPresetClear" />
                            </Grid>
                        </Border>

                        <!-- 2. 核心下拉选择（3x2 规整对齐） -->
                        <Border Background="{StaticResource InputSoftBrush}" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="发长" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding HairLengthOptions}"
                                          SelectedValue="{Binding SelectedHairLength}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="胸部尺寸" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="0" Grid.Column="4" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding BreastsSizeOptions}"
                                          SelectedValue="{Binding SelectedBreastsSize}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="服装" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AttireModeOptions}"
                                          SelectedValue="{Binding AttireMode}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="动作" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="2" Grid.Column="4" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding ActionModeOptions}"
                                          SelectedValue="{Binding ActionMode}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="场景" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="4" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding SceneModeOptions}"
                                          SelectedValue="{Binding SceneMode}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />

                                <TextBlock Grid.Row="4" Grid.Column="3" Text="兽耳" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Row="4" Grid.Column="4" Height="26" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding EarsModeOptions}"
                                          SelectedValue="{Binding EarsMode}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" />
                            </Grid>
                        </Border>

                        <!-- 3. 人物外貌 -->
                        <TextBlock Text="人物外貌" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,5" />
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <CheckBox Content="发色" IsChecked="{Binding HairColor}" Margin="0,0,6,5" />
                            <CheckBox Content="发型" IsChecked="{Binding HairStyles}" Margin="0,0,6,5" />
                            <CheckBox Content="瞳色/眼型(30%)" IsChecked="{Binding Eyes}" Margin="0,0,6,5" ToolTip="勾选后仅 30% 概率触发抽取" />
                            <CheckBox Content="表情" IsChecked="{Binding FaceAndExpression}" Margin="0,0,6,5" />
                            <CheckBox Content="细节" IsChecked="{Binding BodyDetails}" Margin="0,0,6,5"
                                      ToolTip="包含胸部细节、脚部及体型尾巴等细节，启用时每次抽取 2~3 个" />
                        </UniformGrid>

                        <!-- 4. 穿搭与配饰 -->
                        <TextBlock Text="穿搭与配饰" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,5" />
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <CheckBox Content="配饰" IsChecked="{Binding Accessories}" Margin="0,0,6,5" />
                            <CheckBox Content="袜类/腿饰" IsChecked="{Binding Legwear}" Margin="0,0,6,5" />
                            <CheckBox Content="鞋类" IsChecked="{Binding Footwear}" Margin="0,0,6,5" />
                            <CheckBox Content="不穿鞋" IsChecked="{Binding NoShoes}" Margin="0,0,6,5"
                                      ToolTip="固定输出 no shoes，与「鞋类」互斥" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 / 抽取明细 ============ -->
            <TabControl Grid.Column="2" x:Name="TabsOutput" Margin="0" Padding="0">
                <TabItem Header="提示词" x:Name="TabPrompt" IsSelected="True">
                    <DockPanel LastChildFill="True" Margin="0" TextElement.FontWeight="Normal">
                        <Border DockPanel.Dock="Top" Padding="10,6"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}"
                                        CornerRadius="9" Padding="7,1.5" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtMeta}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="TxtMeta" Text="{Binding MetaText}" FontSize="11.5" Foreground="{StaticResource AccentDeep}" />
                                </Border>
                                <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasResult}"
                                        MinHeight="28" Padding="12,4" Click="OnCopy" />
                                <Button DockPanel.Dock="Right" x:Name="BtnAppendToBatch" Content="追加到"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasResult}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnAppendToBatch"
                                        ToolTip="把结果追加到「批量提交」的正向提示词队列末尾，不清空且不跳转" />
                                <Button DockPanel.Dock="Right" x:Name="BtnSendToBatch" Content="发送到"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasResult}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSendToBatch"
                                        ToolTip="清空「批量提交」的正向提示词队列，填入当前结果并跳转过去" />
                                <Button DockPanel.Dock="Right" x:Name="BtnSave" Content="保存…"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding HasResult}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSave" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <TextBox x:Name="TxtResult" Text="{Binding ResultText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True" Cursor="IBeam"
                                     Style="{StaticResource ConsoleBox}"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="10,8" FontSize="16"
                                     FontWeight="Normal" Foreground="{StaticResource Ink}" />
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="抽取明细" x:Name="TabLog">
                    <TextBox x:Name="TxtLog" Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" Cursor="IBeam" Margin="8,8,8,8"
                             Style="{StaticResource ConsoleBox}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                             Foreground="{StaticResource InkSoft}" Background="{StaticResource InputSoftBrush}"
                             FontSize="15" FontWeight="Normal" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="1" Margin="12,12,12,12" Padding="12" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnRoll" Content="抽卡" Padding="24,7"
                        MinWidth="112" Command="{Binding RollCommand}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="按当前设置抽取提示词（F5 / Ctrl+Enter）" />
                <Button Grid.Column="1" x:Name="BtnClear" Content="清空结果" Padding="16,7"
                        MinWidth="76" Margin="8,0,0,0" Click="OnClear" />

                <TextBlock Grid.Column="2" x:Name="TxtStatus" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0,4,0" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
