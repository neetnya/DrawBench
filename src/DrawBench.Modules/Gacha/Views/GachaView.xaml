<UserControl x:Class="DrawBench.Modules.Gacha.Views.GachaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：参数 + 日志 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="抽卡设置" Padding="12,10,12,10">
                    <StackPanel>
                        <!-- 通用 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="等级" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="CmbLevel" SelectedIndex="5">
                                <ComboBoxItem Content="sfw" />
                                <ComboBoxItem Content="suggestive" />
                                <ComboBoxItem Content="explicit" />
                                <ComboBoxItem Content="hardcore" />
                                <ComboBoxItem Content="extreme" />
                                <ComboBoxItem Content="any" />
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="连抽" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                            <TextBox Grid.Column="3" x:Name="TxtRepeat" Text="1" />
                        </Grid>

                        <!-- 角色分组 -->
                        <Grid Margin="0,9,0,6">
                            <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Card}" Padding="0,0,9,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="角色 · 女性特征" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" />
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="池" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CmbPool" SelectedIndex="0">
                                <ComboBoxItem Content="热门 TOP200" />
                                <ComboBoxItem Content="热门 TOP1000" />
                                <ComboBoxItem Content="全部女性" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="关系" Style="{StaticResource FieldLabel}" Margin="0,3,6,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbRelation" SelectedIndex="0">
                                <ComboBoxItem Content="auto（按等级）" Tag="auto" />
                                <ComboBoxItem Content="normal（正常互动）" Tag="normal" />
                                <ComboBoxItem Content="yuri（百合）" Tag="yuri" />
                                <ComboBoxItem Content="none（不加）" Tag="none" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="人数" Style="{StaticResource FieldLabel}" Margin="10,3,6,0" />
                            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CmbCount" SelectedIndex="0">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                            </ComboBox>
                        </Grid>

                        <WrapPanel Margin="0,7,0,0">
                            <CheckBox x:Name="ChkHuge" Content="强制巨乳" Margin="0,0,16,0" />
                            <CheckBox x:Name="ChkNoAvoid" Content="关闭避重" Margin="0,0,16,0" />
                        </WrapPanel>

                        <!-- 装扮分组 -->
                        <Grid Margin="0,9,0,6">
                            <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Card}" Padding="0,0,9,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="装扮 · 服装 / 姿势 / 表情 / 场景" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" />
                            </Border>
                        </Grid>

                        <WrapPanel>
                            <CheckBox x:Name="ChkNoOutfit" Content="不抽服装" Margin="0,0,16,3" />
                            <CheckBox x:Name="ChkNoPose" Content="不抽姿势" Margin="0,0,16,3" />
                            <CheckBox x:Name="ChkNoExpr" Content="不抽表情" Margin="0,0,16,3" />
                            <CheckBox x:Name="ChkNoScene" Content="不抽场景" Margin="0,0,16,3" />
                            <CheckBox x:Name="ChkAllowPublic" Content="允许公共场合暴露" Margin="0,0,16,3" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="日志" Padding="0" Margin="0">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                             Style="{StaticResource ConsoleBox}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                             Foreground="{StaticResource InkSoft}" Background="{StaticResource InputSoftBrush}"
                             FontSize="12" />
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 ============ -->
            <GroupBox Grid.Column="2" Header="提示词" Padding="0" Margin="0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Padding="10,6"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}"
                                    CornerRadius="9" Padding="7,1.5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtMeta}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="TxtMeta" FontSize="11.5" Foreground="{StaticResource AccentDeep}" />
                            </Border>
                            <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Click="OnCopy" />
                            <Button DockPanel.Dock="Right" x:Name="BtnSendToBatch" Content="发送到队列"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSendToBatch"
                                    ToolTip="把结果直接送进「批量提交」模块的正向提示词队列" />
                            <Button DockPanel.Dock="Right" x:Name="BtnSave" Content="保存…"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSave" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <TextBox x:Name="TxtResult" IsReadOnly="True" AcceptsReturn="True"
                                 Style="{StaticResource ConsoleBox}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="14,12" FontSize="13"
                                 Foreground="{StaticResource Ink}" />
                        <TextBlock IsHitTestVisible="False" Margin="16,15,16,0" VerticalAlignment="Top"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="#AEB7C6"
                                   Text="点下面的按钮抽一次，抽中的提示词会显示在这里">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtResult}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="1" Margin="12,12,12,12" Padding="12" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnGirl" Content="抽角色" Padding="20,7"
                        MinWidth="98" Click="OnGirl" ToolTip="只抽角色本身，不管穿什么" />
                <Button Grid.Column="1" x:Name="BtnGirlRoll" Content="角色 + 装扮" Padding="20,7"
                        MinWidth="122" Margin="8,0,0,0" Click="OnGirlRoll"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="先抽角色，再给每个角色配一套服装 / 姿势 / 表情 / 场景" />
                <Button Grid.Column="2" x:Name="BtnRoll" Content="抽装扮" Padding="20,7"
                        MinWidth="98" Margin="8,0,0,0" Click="OnRoll"
                        ToolTip="只抽装扮；提示词为空时从头抽一套" />
                <Button Grid.Column="3" x:Name="BtnCancel" Content="取消" Padding="16,7"
                        MinWidth="76" Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />

                <TextBlock Grid.Column="4" x:Name="TxtStatus" VerticalAlignment="Center"
                           Margin="16,0,4,0" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
