<UserControl x:Class="DrawBench.Modules.Gacha.Views.GachaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：抽卡设置（重新排版：基础设置 → 核心下拉 → 维度勾选） ============ -->
            <GroupBox Grid.Column="0" Header="抽卡设置" Padding="10,8,10,8" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <!-- 1. 通用控制 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="连抽" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" x:Name="TxtRepeat" Text="1" />
                                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkSpace" Content="下划线转空格"
                                              IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkNsfw" Content="NSFW"
                                              IsChecked="False" Margin="0,0,12,0" VerticalAlignment="Center"
                                              ToolTip="关闭时只抽 SFW 安全词；开启时混合抽取 SFW 与 NSFW 词" />
                                    <CheckBox x:Name="ChkMultiPerson" Content="多人"
                                              IsChecked="False" VerticalAlignment="Center"
                                              ToolTip="关闭时不抽需要多人的 tag；开启时若抽到多人 tag 则自动屏蔽前置 1girl，未抽到则保留" />
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="前置" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPrefix" Text="1girl"
                                         ToolTip="固定拼接在每条结果最前面，逗号分隔" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="后置" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSuffix" Text="" Margin="0,4,0,0"
                                         ToolTip="固定拼接在每条结果最后面，逗号分隔" />
                            </Grid>

                            <!-- 快捷方案 -->
                            <WrapPanel Margin="0,8,0,4">
                                <Button Content="常规全身" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        ToolTip="人物 + 穿搭 + 姿势 + 地点环境"
                                        Click="OnPresetStandard" />
                                <Button Content="人设外貌" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        ToolTip="脸、眼、发、兽耳 + 纯白背景，适合人设立绘"
                                        Click="OnPresetCharacterOnly" />
                                <Button Content="服装展示" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        ToolTip="服装、鞋袜、配饰、姿势 + 纯白背景"
                                        Click="OnPresetOutfit" />
                                <Button Content="全部清空" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,0,4"
                                        Click="OnPresetClear" />
                            </WrapPanel>

                            <!-- 2. 核心下拉选择（2x2 规整对齐） -->
                            <Border Background="{StaticResource InputSoftBrush}" BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="发长" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbHairLength" Height="26" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" />

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="胸部尺寸" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="0" Grid.Column="4" x:Name="CmbBreastsSize" Height="26" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="服装" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbAttireMode" Height="26" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" />

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="动作" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="4" x:Name="CmbActionMode" Height="26" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="场景" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbSceneMode" Height="26" VerticalContentAlignment="Center"
                                              DisplayMemberPath="Label" SelectedValuePath="Value" />
                                </Grid>
                            </Border>

                            <!-- 3. 人物外貌 -->
                            <TextBlock Text="人物外貌" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,5" />
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkHairColor" Content="发色" IsChecked="True" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkHairStyles" Content="发型" IsChecked="True" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkHairAccessories" Content="发饰" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkEyeColor" Content="瞳色(30%)" IsChecked="True" Margin="0,0,6,5" ToolTip="勾选后仅 30% 概率触发抽取" />
                                <CheckBox x:Name="ChkEyes" Content="眼型/瞳型(30%)" IsChecked="True" Margin="0,0,6,5" ToolTip="勾选后仅 30% 概率触发抽取" />
                                <CheckBox x:Name="ChkFace" Content="表情" IsChecked="True" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkEarsRare" Content="兽耳(15%)" Margin="0,0,6,5" Checked="OnEarsToggleChanged"
                                          ToolTip="勾选后仅 15% 概率触发抽取；与「兽耳」互斥" />
                                <CheckBox x:Name="ChkEars" Content="兽耳(100%)" Margin="0,0,6,5" Checked="OnEarsToggleChanged"
                                          ToolTip="勾选后 100% 抽取；与「兽耳(15%)」互斥" />
                                <CheckBox x:Name="ChkBodyDetails" Content="细节" IsChecked="False" Margin="0,0,6,5"
                                          ToolTip="包含胸部细节、脚部及体型尾巴等细节，启用时每次抽取 2~3 个" />
                            </UniformGrid>

                            <!-- 4. 穿搭与配饰 -->
                            <TextBlock Text="穿搭与配饰" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,2,0,5" />
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <CheckBox x:Name="ChkAccessories" Content="头饰/配饰" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkLegwear" Content="袜类/腿饰" IsChecked="True" Margin="0,0,6,5" />
                                <CheckBox x:Name="ChkFootwear" Content="鞋类" IsChecked="True" Margin="0,0,6,5" />
                            </UniformGrid>



                        </StackPanel>
                    </ScrollViewer>
            </GroupBox>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 / 抽取明细 ============ -->
            <TabControl Grid.Column="2" x:Name="TabsOutput" Margin="0" Padding="0">
                <TabItem Header="提示词" x:Name="TabPrompt" IsSelected="True">
                    <DockPanel LastChildFill="True" Margin="0">
                        <Border DockPanel.Dock="Top" Padding="10,6"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}"
                                        CornerRadius="9" Padding="7,1.5" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtMeta}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="TxtMeta" FontSize="11.5" Foreground="{StaticResource AccentDeep}" />
                                </Border>
                                <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="12,4" Click="OnCopy" />
                                <Button DockPanel.Dock="Right" x:Name="BtnAppendToBatch" Content="追加到"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnAppendToBatch"
                                        ToolTip="把结果追加到「批量提交」的正向提示词队列末尾，不清空且不跳转" />
                                <Button DockPanel.Dock="Right" x:Name="BtnSendToBatch" Content="发送到"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSendToBatch"
                                        ToolTip="清空「批量提交」的正向提示词队列，填入当前结果并跳转过去" />
                                <Button DockPanel.Dock="Right" x:Name="BtnSave" Content="保存…"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSave" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <TextBox x:Name="TxtResult" IsReadOnly="True" AcceptsReturn="True"
                                     Style="{StaticResource ConsoleBox}"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="10,8" FontSize="16"
                                     FontWeight="Normal" Foreground="{StaticResource Ink}" />
                            <TextBlock IsHitTestVisible="False" Margin="16,15,16,0" VerticalAlignment="Top"
                                       TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}"
                                       Text="在左侧选择需要的参数，点击下方「抽卡」即可生成提示词">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtResult}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="抽取明细" x:Name="TabLog">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" Margin="8,8,8,8"
                             Style="{StaticResource ConsoleBox}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                             Foreground="{StaticResource InkSoft}" Background="{StaticResource InputSoftBrush}"
                             FontSize="15" FontWeight="Normal" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="1" Margin="12,12,12,12" Padding="12" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnRoll" Content="抽卡" Padding="24,7"
                        MinWidth="112" Click="OnRoll"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="按当前设置抽取提示词" />
                <Button Grid.Column="1" x:Name="BtnClear" Content="清空" Padding="16,7"
                        MinWidth="76" Margin="8,0,0,0" Click="OnClear" />

                <TextBlock Grid.Column="2" x:Name="TxtStatus" VerticalAlignment="Center"
                           Margin="16,0,4,0" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
