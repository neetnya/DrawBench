<UserControl x:Class="DrawBench.Modules.Gacha.Views.GachaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：模块选项 + 日志 ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="抽卡模块设置" Padding="10,8,10,8" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <!-- 通用设置 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="连抽" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" x:Name="TxtRepeat" Text="1" />
                                <CheckBox Grid.Column="3" x:Name="ChkSpace" Content="下划线转空格（推荐）"
                                          IsChecked="True" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="前置" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPrefix" Text="1girl, solo"
                                         ToolTip="固定拼接在每条结果最前面，逗号分隔" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="后置" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSuffix" Text="" Margin="0,4,0,0"
                                         ToolTip="固定拼接在每条结果最后面，逗号分隔" />
                            </Grid>

                            <!-- 快捷方案 -->
                            <WrapPanel Margin="0,8,0,2">
                                <Button Content="常规全身" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        Click="OnPresetStandard" />
                                <Button Content="仅人设外貌" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        Click="OnPresetCharacterOnly" />
                                <Button Content="全选（不含NSFW）" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,6,4"
                                        Click="OnPresetAllSfw" />
                                <Button Content="全部清空" Style="{StaticResource SecondaryButton}"
                                        Padding="8,3" MinHeight="24" FontSize="11.5" Margin="0,0,0,4"
                                        Click="OnPresetClear" />
                            </WrapPanel>

                            <!-- 1. 头发 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="头发（hair）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkHairColor" Content="发色" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHairStyles" Content="发型/发长" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHairAccessories" Content="发饰" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHairTraits" Content="发质/动态" Margin="0,0,14,3" />
                            </WrapPanel>

                            <!-- 2. 面部与五官 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="面部与五官（face_and_eyes）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkEyes" Content="眼睛/视线" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkFace" Content="表情/面部" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkEars" Content="耳朵/兽耳" Margin="0,0,14,3" />
                            </WrapPanel>

                            <!-- 3. 身体部位 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="身体部位（body_parts）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkBreasts" Content="胸部" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkAss" Content="臀部" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHands" Content="手部" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkFeet" Content="脚部" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkShoulders" Content="肩部" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkBodyOther" Content="其他部位" Margin="0,0,14,3" />
                            </WrapPanel>

                            <!-- 4. 服装与配饰 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="服装与配饰（attire_and_accessories）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkFashionStyle" Content="穿搭风格" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkClothing" Content="主服装" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHeadwear" Content="帽子/头饰" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkNeckwear" Content="颈饰/领饰" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkSleeves" Content="袖型" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHandwear" Content="手套/手饰" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkLegwear" Content="袜类/腿饰" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkFootwear" Content="鞋类" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkAccessories" Content="其他配饰" Margin="0,0,14,3" />
                            </WrapPanel>

                            <!-- 5. 姿势与动作 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="姿势与动作（pose_and_action）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkPosture" Content="全身姿势" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkGestures" Content="手势" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkDances" Content="舞蹈" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkHolding" Content="手持物" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkVerbs" Content="一般动作" Margin="0,0,14,3" />
                            </WrapPanel>

                            <!-- 6. 场景与构图 -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="场景与构图（scene_and_composition）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <CheckBox x:Name="ChkLocations" Content="地点环境" IsChecked="True" Margin="0,0,14,3" Checked="OnSceneBgToggleChanged" ToolTip="与「纯色/抽象背景」互斥" />
                                <CheckBox x:Name="ChkBackgrounds" Content="纯色/抽象背景" Margin="0,0,14,3" Checked="OnSceneBgToggleChanged" ToolTip="与「地点环境」互斥" />
                                <CheckBox x:Name="ChkLighting" Content="光影" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkComposition" Content="构图/视角" IsChecked="True" Margin="0,0,14,3" />
                                <CheckBox x:Name="ChkSceneObjects" Content="场景物件" Margin="0,0,14,3" ToolTip="灯具、道具、背景铺陈物等" />
                            </WrapPanel>

                            <!-- 7. 成人向 (NSFW) -->
                            <Grid Margin="0,8,0,4">
                                <Border Height="1" Background="{StaticResource LineSoft}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource Card}" Padding="0,0,8,0" HorizontalAlignment="Left">
                                    <TextBlock Text="成人向（nsfw）" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                            <StackPanel>
                                <CheckBox x:Name="ChkEnableNsfw" Content="启用 NSFW 模块" Margin="0,0,0,4"
                                          Checked="OnNsfwToggleChanged" Unchecked="OnNsfwToggleChanged" />
                                <WrapPanel x:Name="PanelNsfwSubs" IsEnabled="False" Margin="16,0,0,0">
                                    <CheckBox x:Name="ChkNsfwNudity" Content="裸露/遮挡" Margin="0,0,14,3" />
                                    <CheckBox x:Name="ChkNsfwAttire" Content="情趣服饰" Margin="0,0,14,3" />
                                    <CheckBox x:Name="ChkNsfwActs" Content="性行为" Margin="0,0,14,3" />
                                    <CheckBox x:Name="ChkNsfwPositions" Content="体位" Margin="0,0,14,3" />
                                    <CheckBox x:Name="ChkNsfwObjects" Content="器具/道具" Margin="0,0,14,3" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="抽取明细" Padding="0" Margin="0">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                             Style="{StaticResource ConsoleBox}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                             Foreground="{StaticResource InkSoft}" Background="{StaticResource InputSoftBrush}"
                             FontSize="12" />
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitLine}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ============ 右：提示词 ============ -->
            <GroupBox Grid.Column="2" Header="提示词" Padding="0" Margin="0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Padding="10,6"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}"
                                    CornerRadius="9" Padding="7,1.5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtMeta}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="TxtMeta" FontSize="11.5" Foreground="{StaticResource AccentDeep}" />
                            </Border>
                            <Button DockPanel.Dock="Right" x:Name="BtnCopy" Content="复制"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Click="OnCopy" />
                            <Button DockPanel.Dock="Right" x:Name="BtnAppendToBatch" Content="追加到"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnAppendToBatch"
                                    ToolTip="把结果追加到「批量提交」的正向提示词队列末尾，不清空且不跳转" />
                            <Button DockPanel.Dock="Right" x:Name="BtnSendToBatch" Content="发送到"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSendToBatch"
                                    ToolTip="清空「批量提交」的正向提示词队列，填入当前结果并跳转过去" />
                            <Button DockPanel.Dock="Right" x:Name="BtnSave" Content="保存…"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,4" Margin="0,0,6,0" Click="OnSave" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <TextBox x:Name="TxtResult" IsReadOnly="True" AcceptsReturn="True"
                                 Style="{StaticResource ConsoleBox}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Padding="8,6" FontSize="13"
                                 Foreground="{StaticResource Ink}" />
                        <TextBlock IsHitTestVisible="False" Margin="16,15,16,0" VerticalAlignment="Top"
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   Text="在左侧勾选需要的模块，点击下方「抽卡」即可生成提示词">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtResult}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- ============ 底栏 ============ -->
        <Border Grid.Row="1" Margin="12,12,12,12" Padding="12" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnRoll" Content="抽卡" Padding="24,7"
                        MinWidth="112" Click="OnRoll"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="按当前勾选的模块抽取提示词" />
                <Button Grid.Column="1" x:Name="BtnClear" Content="清空" Padding="16,7"
                        MinWidth="76" Margin="8,0,0,0" Click="OnClear" />

                <TextBlock Grid.Column="2" x:Name="TxtStatus" VerticalAlignment="Center"
                           Margin="16,0,4,0" Foreground="{StaticResource Muted}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
