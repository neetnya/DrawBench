<Project Sdk="Microsoft.NET.Sdk">

  <!--
      五个工具作为模块放在这里，一个功能一个文件夹。
      各自带一份独立的 ResourceDictionary（Resources\*.xaml），
      目录内键名只在本模块内唯一，所以不会互相覆盖。
  -->
  <PropertyGroup>
    <RootNamespace>AIArtToolBox.Modules</RootNamespace>
    <AssemblyName>AIArtToolBox.Modules</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIArtToolBox.Core\AIArtToolBox.Core.csproj" />
  </ItemGroup>

  <!-- 反推模块的 ONNX 推理（本机 NuGet 缓存里已有 1.31.1，离线可构建） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <!-- 抽卡引擎与拼图脚本留在源码目录，由 App 工程拷到 exe 同级 -->
  <ItemGroup>
    <None Include="Gacha\engine\**\*" Exclude="Gacha\engine\**\__pycache__\**" CopyToOutputDirectory="None" />
    <None Include="Collage\gen_sheets_cli.py" CopyToOutputDirectory="None" />
  </ItemGroup>

</Project>
