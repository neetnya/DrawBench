<UserControl x:Class="AIArtToolBox.Modules.Batch.Views.BatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：只保留地址 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="ComfyUI 地址:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtBaseUrl" Width="260" Margin="8,0" Padding="4"
                     Text="http://127.0.0.1:8188" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Text="就绪" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- 主体：左侧工作流列表 + 右侧提示词队列 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 工作流勾选区：只提交勾选的 JSON -->
            <GroupBox Grid.Column="0" Header="工作流列表" Padding="6,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnSelectAll" Content="全选" Click="BtnSelectAll_Click"
                                Padding="10,2" Margin="0,0,6,0"/>
                        <Button x:Name="BtnSelectNone" Content="全不选" Click="BtnSelectNone_Click"
                                Padding="10,2" Margin="0,0,6,0"/>
                        <Button x:Name="BtnReloadWorkflows" Content="刷新" Click="BtnReloadWorkflows_Click"
                                Padding="10,2"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="拖入 .json 可添加"/>
                        <Button x:Name="BtnOpenWorkflowFolder" Grid.Column="1" Content="打开目录"
                                Click="BtnOpenWorkflowFolder_Click" Padding="8,2" FontSize="11"
                                Margin="6,0,0,0" ToolTip="在资源管理器中打开 api 工作流目录"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True"
                                  PreviewDragOver="WorkflowList_DragOver"
                                  PreviewDrop="WorkflowList_Drop">
                        <ItemsControl x:Name="LstWorkflows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding Path}"
                                              Padding="4,5" Margin="0,0,0,1" MinHeight="26"
                                              VerticalContentAlignment="Center">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAF1FA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- 提示词区（正向每行一组，负向整框一条；都能拖入 txt） -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 左：正向提示词队列，占满整个高度 -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="正向提示词队列"
                               Foreground="#555" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtPromptQueue"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                             Padding="8" Text="" AllowDrop="True"
                             PreviewDragOver="Prompt_PreviewDragOver"
                             PreviewDrop="Prompt_PreviewDrop"
                             ToolTip="每行一组提示词，会依次写入标题含 Positive 的正向提示词节点。"/>
                </DockPanel>

                <!-- 右栏：负面词在上，配置区和日志填满它下面的空白 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="负面提示词（整框一条）"
                               Foreground="#555" Margin="0,0,0,6"/>

                    <!-- 负面词只有一条，不需要大区域 -->
                    <TextBox x:Name="TxtNegativePrompt" Grid.Row="1"
                             Height="120" VerticalAlignment="Top"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                             Padding="8" Text="" AllowDrop="True"
                             PreviewDragOver="Prompt_PreviewDragOver"
                             PreviewDrop="Prompt_PreviewDrop"
                             ToolTip="留空则不修改工作流里的负面提示词。填写后按与正向词相同的规则写入标题含 Negative 的节点（支持「Negative Prompt」占位符，否则追加到模板原文后面）；整个框算一条负面词，不按行分组，本批所有图共用。"/>

                    <!-- 配置区 -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="每组生成数量:"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtCount" Grid.Row="0" Grid.Column="1" Width="120"
                                 Margin="8,2,0,2" Padding="4" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" Text="1"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="日期后缀:"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtDate" Grid.Row="1" Grid.Column="1" Width="120"
                                 Margin="8,2,0,2" Padding="4" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" Text=""
                                 ToolTip="追加到保存文件名前缀后的日期。软件启动时自动填入当天日期（yyMMdd），可手动修改；点击「开始批量排队」不会重置它。"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="种子:"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtSeed" Grid.Row="2" Grid.Column="1" Width="120"
                                 Margin="8,2,0,2" Padding="4" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" Text="-1"
                                 TextChanged="TxtSeed_TextChanged"
                                 ToolTip="-1 表示保持原来的随机逻辑（按下面的锁定 seed 选项随机）；填其它整数则本批所有图都固定使用该 seed，此时「锁定 seed / 全局锁定 seed」不生效。"/>

                        <CheckBox x:Name="ChkLockSeed" Grid.Row="3" Grid.ColumnSpan="2"
                                  Margin="0,10,0,0" VerticalAlignment="Center"
                                  Content="🔒 锁定 seed"
                                  ToolTip="勾选后：同一条提示词提交到所有工作流时使用同一个 seed，方便对比不同工作流；不同提示词之间仍然各自随机。填了固定种子时以固定种子为准。"/>

                        <CheckBox x:Name="ChkGlobalLockSeed" Grid.Row="4" Grid.ColumnSpan="2"
                                  Margin="0,6,0,0" VerticalAlignment="Center"
                                  Content="🌐 全局锁定 seed"
                                  Checked="ChkGlobalLockSeed_Changed" Unchecked="ChkGlobalLockSeed_Changed"
                                  ToolTip="勾选后：按轮生成 seed，每一轮开始随机一个 seed，本轮内所有提示词、所有工作流共用该 seed，画完这一轮再换下一个 seed 重复。每组生成数量为 N 时共 N 轮，同一轮内的图相同；与「锁定 seed」同时勾选时以本项为准。填了固定种子时以固定种子为准。"/>

                        <Button x:Name="BtnRun" Grid.Row="5" Grid.ColumnSpan="2"
                                Content="开始批量排队" Click="BtnRun_Click"
                                Margin="0,14,0,0" Padding="0,8"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>

                    <!-- 日志区：吃掉右栏剩下的高度 -->
                    <GroupBox Grid.Row="3" Header="运行日志" Padding="4" Margin="0,14,0,0">
                        <TextBox x:Name="TxtLog" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" Text="" IsTabStop="False"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
