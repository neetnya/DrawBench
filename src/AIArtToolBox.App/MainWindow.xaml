<Window x:Class="AIArtToolBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIArtToolBox" Height="820" Width="1320"
        MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧竖排导航 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- 标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="18,18,14,14">
                    <TextBlock Text="AIArtToolBox" Style="{StaticResource TitleText}" />
                    <TextBlock x:Name="TxtSubtitle" Text="ComfyUI 出图工具集"
                               Style="{StaticResource SubText}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 底部：设置 + 版本 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                    <RadioButton x:Name="BtnSettings" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Settings_Checked" Margin="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="设置" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock x:Name="TxtVersion" Style="{StaticResource SubText}"
                               Margin="18,10,14,0" FontSize="11" />
                </StackPanel>

                <!-- 模块列表（代码里填充） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="ContentHost" Grid.Row="0" Margin="0" />

            <!-- 状态栏 -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="14,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtStatus" Grid.Column="0" Style="{StaticResource SubText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtPython" Grid.Column="1" Style="{StaticResource SubText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock x:Name="TxtComfy" Grid.Column="2" Style="{StaticResource SubText}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
