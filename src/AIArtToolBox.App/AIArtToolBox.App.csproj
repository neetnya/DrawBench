<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AIArtToolBox.App</RootNamespace>
    <AssemblyName>AIArtToolBox</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 与 WD14 一致：发布时打 x64 自包含，模型和脚本留在目录里 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIArtToolBox.Core\AIArtToolBox.Core.csproj" />
    <ProjectReference Include="..\AIArtToolBox.Modules\AIArtToolBox.Modules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <!-- Python 脚本随生成拷到 exe 同级：engine\（抽卡）与 scripts\（拼图） -->
  <ItemGroup>
    <None Include="..\AIArtToolBox.Modules\Gacha\engine\**\*"
          Exclude="..\AIArtToolBox.Modules\Gacha\engine\**\__pycache__\**"
          Link="engine\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\AIArtToolBox.Modules\Collage\gen_sheets_cli.py"
          Link="scripts\gen_sheets_cli.py"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 第三方许可随发布包一起走（MIT 要求保留版权声明） -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third-party\*.txt" Link="third-party\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
