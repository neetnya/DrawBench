<Window x:Class="DrawBench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DrawBench 出图工作台" Height="760" Width="1320"
        MinHeight="560" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧竖排导航 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- 标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="18,18,14,14">
                    <TextBlock Text="出图工作台" Style="{StaticResource TitleText}" FontSize="18" />
                    <TextBlock Text="DrawBench" Style="{StaticResource SubText}" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>

                <!-- 底部：设置 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Border Height="1" Background="{StaticResource Line}" Margin="14,0,14,8" />
                    <RadioButton x:Name="BtnSettings" Style="{StaticResource NavButton}"
                                 GroupName="Nav" Checked="Settings_Checked" Margin="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="设置" FontSize="14.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 模块列表（代码里填充） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0" />
    </Grid>
</Window>
